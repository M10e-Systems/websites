<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  {% if summary or site.description %}
  <meta name="description" content="{{ summary or site.description }}">
  {% endif %}
  <link rel="stylesheet" href="/kb.css">
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>

  <header class="site-header">
    <div class="container header-inner">
      <div class="brand">
        <a href="/">{{ site.title }}</a>
      </div>
      <nav class="site-nav" aria-label="Primary">
        <a href="/">Home</a>
        <a href="/blog/">Blog</a>
      </nav>
    </div>
  </header>

  <main id="content" class="container prose">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p class="muted">© Kevin Barrett</p>
    </div>
  </footer>
</body>
</html>

